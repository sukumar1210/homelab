#!/usr/bin/env bash
# claude-later: queue a message for a Claude session, delivered at a set time.
#
#   claude-later <when> <session> <message...>   when = anything `date -d` reads:
#                                                 "15:00", "tomorrow 09:20", "now + 2 hours"
#   claude-later list
#   claude-later cancel <id>
#
# The queue is systemd user timers (linger is on, so they fire after logout).
# A running session gets the message through SendMessage, relayed by a
# throwaway headless Claude; a stopped one is resumed in the background with it.
# A failed delivery stays queued. Logs: journalctl --user -u 'claude-later-*'
set -euo pipefail
q=~/.claude/later
mkdir -p "$q"

case "${1:-}" in
list)
  for f in "$q"/*.msg; do
    [ -e "$f" ] || continue
    { read -r target; read -r at; msg=$(cat); } <"$f"
    printf '%s  %s  -> %s: %s\n' "$(basename "$f" .msg)" "$at" "$target" "$msg"
  done
  exit ;;
cancel)
  systemctl --user stop "claude-later-$2.timer" 2>/dev/null || true
  rm -f "$q/$2.msg"
  exit ;;
deliver)
  f="$q/$2.msg"
  { read -r target; read -r at; msg=$(cat); } <"$f"
  text="Queued message from the user (claude-later, $at): $msg"
  s=$(claude agents --json --all | jq -c --arg t "$target" \
    'first(.[] | select(.name == $t or .id == $t or .sessionId == $t)) // empty')
  if [ -n "$s" ] && [[ $(jq -r .status <<<"$s") =~ ^(idle|busy)$ ]]; then
    out=$(printf 'Use the SendMessage tool to send the text between the markers, verbatim, to the Claude session named %s. Load SendMessage with ToolSearch first. Do nothing else, then reply SENT or FAILED with the reason.\n<<<\n%s\n>>>\n' \
      "$(jq -r .name <<<"$s")" "$text" |
      claude -p --model haiku --no-session-persistence --allowedTools ToolSearch SendMessage ListAgents)
    echo "$out"
    grep -qxE 'SENT\.?' <<<"$out"
  else
    cwd=$HOME sid=$target
    [ -n "$s" ] && { cwd=$(jq -r .cwd <<<"$s"); sid=$(jq -r .sessionId <<<"$s"); }
    cd "$cwd"
    claude --bg --resume "$sid" "$text"
  fi
  rm "$f" # only reached on success (set -e), so a failed delivery stays queued
  exit ;;
esac

[ $# -ge 3 ] || { sed -n '4,7p' "$0"; exit 1; }
when=$1 target=$2
shift 2
at=$(date -d "$when" '+%F %T')
[ "$(date -d "$at" +%s)" -gt "$(date +%s)" ] || { echo "$at has already passed" >&2; exit 1; }
id=$(date +%s%3N)
printf '%s\n%s\n%s\n' "$target" "$at" "$*" >"$q/$id.msg"
systemd-run --user --quiet --unit "claude-later-$id" --on-calendar "$at" \
  --timer-property=AccuracySec=1s -E PATH="$PATH" "$(realpath "$0")" deliver "$id"
echo "queued $id: $at -> $target"
